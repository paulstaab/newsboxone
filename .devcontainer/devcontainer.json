{
  "name": "newsboxone",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/home/vscode/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "alexcvzz.vscode-sqlite",
        "ms-playwright.playwright",
        "openai.chatgpt",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/target/**": true
        }
      }
    }
  },
  "forwardPorts": [3000, 8000],
  "postCreateCommand": "mise trust && mise install && mise exec -- cargo fetch --locked --manifest-path backend/Cargo.toml && cd frontend && mise exec -- npm ci && mise exec -- npx playwright install --with-deps",
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],
  "runArgs": [
    "--security-opt=apparmor=unconfined"
  ]
}
